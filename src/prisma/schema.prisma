generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

/// We could not retrieve columns for the underlying table. Either it has none or you are missing rights to see them. Please check your privileges.
model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String    @unique
  password  String
  role      String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  image     String?
  messages  Message[]
  tasks     Task[]
  projects  Project[] @relation("ProjectToUser")

  //   @@unique([createdAt, id])
  // @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model Project {
  id            String   @id @default(cuid())
  title         String
  description   String?
  githubUrl     String?
  deadline      DateTime
  status        String   @default("active")
  progressCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projectColor  String  @default("#8B5CF6")
  tasks         Task[]
  members       User[]   @relation("ProjectToUser")

  @@unique(name: "project_createdAt_id", [createdAt, id])
  @@index([createdAt, id])
}

model Task {
  id          String    @id @default(cuid())
  task        String
  description String?
  priority    String    @default("medium")
  status      String    @default("active")
  dueDate     DateTime
  projectId   String
  memberId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  messages    Message[]
  member      User      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique(name: "task_createdAt_id", [createdAt, id])
  @@index([createdAt, id])
}

model Message {
  id        String   @id @default(cuid())
  image     String?
  file      String?
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  senderId  String
  taskId    String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
